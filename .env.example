# ============================================================
# Frontend (Vite) — Variáveis públicas do navegador
# Copie este arquivo para .env e preencha com suas credenciais
# ============================================================

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Google Cloud (OAuth 2.0 Client ID e API Key para Picker / Drive API v3)
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=sua-google-api-key

# ============================================================
# Servidor (Supabase Edge Functions Secrets)
# Configure via Dashboard do Supabase ou `supabase secrets set`
# NUNCA exponha estes segredos no frontend (.env com prefixo VITE_)
# ============================================================
# GMAIL_USER=seu-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APP_PUBLIC_URL=https://seu-dominio.com
# GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=seu-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=seu-refresh-token-offline
# SUPABASE_SERVICE_ROLE_KEY=disponibilizada-automaticamente-no-supabase
